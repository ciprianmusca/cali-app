{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cali-lab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cali-lab"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cali-lab-db",
      "database_id": "303e2808-3d31-4083-83f7-e915e1b432b2",
      "migrations_dir": "migrations",
      "preview_database_id": "local-cali-lab-db"
    }
  ],
  "routes": [
    {
      "pattern": "cali.ipsv.ro",
      "custom_domain": true
    }
  ]
}
