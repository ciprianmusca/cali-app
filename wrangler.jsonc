{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cali-lab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cali-lab"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cali-lab-db",
      "database_id": "303e2808-3d31-4083-83f7-e915e1b432b2",
      "migrations_dir": "migrations",
      "preview_database_id": "local-cali-lab-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "cali-lab-photos",
      "preview_bucket_name": "cali-lab-photos-preview"
    }
  ],
  "vars": {
    "AUTH_SECRET": "ce3f0b71ac9ca5923bf3cf9be82314f3bbc3d7a2a0ad9d5c9c6f5dbd19f3e770",
    "EXPORT_PSEUDO_SALT": "cali-lab-export-pseudo-7f3a9c2e1b84d6a0"
  },
  "routes": [
    {
      "pattern": "cali.ipsv.ro",
      "custom_domain": true
    }
  ]
}
