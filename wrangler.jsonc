{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cali-lab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cali-lab"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cali-lab-db",
      "database_id": "303e2808-3d31-4083-83f7-e915e1b432b2",
      "migrations_dir": "migrations",
      "preview_database_id": "local-cali-lab-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "cali-lab-photos",
      "preview_bucket_name": "cali-lab-photos-preview"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "vars": {
    "AUTH_SECRET": "ce3f0b71ac9ca5923bf3cf9be82314f3bbc3d7a2a0ad9d5c9c6f5dbd19f3e770",
    "EXPORT_PSEUDO_SALT": "cali-lab-export-pseudo-7f3a9c2e1b84d6a0",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "MAIL_FROM": "noreply@cali-lab.app",
    "MAIL_FROM_NAME": "CALI-LAB",
    "MAIL_REPLY_TO": "contact@cali-lab.app",
    "APP_URL": "https://cali-lab.app"
  },
  "routes": [
    {
      "pattern": "cali-lab.app",
      "custom_domain": true
    },
    {
      "pattern": "www.cali-lab.app",
      "custom_domain": true
    }
  ]
}
